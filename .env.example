# Understudy — copy to .env and fill in what you need.
#   cp .env.example .env
#
# Nothing here is required. With no .env at all, the whole pipeline, the test
# suite and the dashboard run on the deterministic stub. Every variable below
# turns something on.

# ── Models ────────────────────────────────────────────────────────────────
# Set at least one key to have a real model negotiate instead of the rule
# engine. The dashboard's model picker enables itself when a key is present.

OPENAI_API_KEY=
# Model id. Not pinned in code because catalogues move faster than this repo.
# Run `python -m understudy models --provider openai` to list what your key
# can actually reach, then set it here. Default if unset: gpt-4o-mini
OPENAI_MODEL=
# Point at any OpenAI-compatible endpoint: OpenRouter, Together, a local
# Ollama, or a gateway. Leave blank for OpenAI itself.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
# Leave blank for Anthropic itself; set to route via an Anthropic-compatible
# gateway. The SDK reads this variable directly.
ANTHROPIC_BASE_URL=

# ── Voice calls ───────────────────────────────────────────────────────────
# Calling is OFF unless CALLS_ENABLED is exactly "true".
#
# Read this before enabling it. Every outbound call is routed to
# DEMO_CALL_NUMBER regardless of what phone number the listing data carries —
# the seller's number is never dialled, and private individuals are refused
# outright. Cold AI-voice calls to consumers are regulated (TCPA). Put your
# own phone here and have someone play the seller.

CALLS_ENABLED=false
# E.164, e.g. +15551234567. A number YOU control.
DEMO_CALL_NUMBER=

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Public HTTPS URL Vapi can post call events back to (e.g. an ngrok domain).
PUBLIC_URL=
# Model Vapi runs on the call. Voice is latency-bound: a thinking-heavy model
# leaves dead air while the seller waits. Default if unset: claude-opus-5
VOICE_MODEL=
